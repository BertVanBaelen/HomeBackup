 "components": {
  "schemas": {
   "Attention": {
    "properties": {
     "item_id": {
      "type": "string",
      "title": "Item Id"
     },
     "days_since_success": {
      "type": "integer",
      "title": "Days Since Success"
     },
     "last_run": {
      "$ref": "#/components/schemas/RunSummary"
     }
    },
    "type": "object",
    "required": [
     "item_id",
     "days_since_success",
     "last_run"
    ],
    "title": "Attention"
   },
   "BackupType": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "version": {
      "type": "string",
      "title": "Version",
      "default": "1"
     },
     "builtin": {
      "type": "boolean",
      "title": "Builtin",
      "default": true
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "BackupType"
   },
   "Check": {
    "properties": {
     "level": {
      "type": "string",
      "enum": [
       "ok",
       "warning",
       "error"
      ],
      "title": "Level"
     },
     "message": {
      "$ref": "#/components/schemas/Message"
     }
    },
    "type": "object",
    "required": [
     "level",
     "message"
    ],
    "title": "Check"
   },
   "ConfigStatus": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "valid": {
      "type": "boolean",
      "title": "Valid"
     },
     "items": {
      "type": "integer",
      "title": "Items"
     },
     "targets": {
      "type": "integer",
      "title": "Targets"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     }
    },
    "type": "object",
    "required": [
     "path",
     "valid",
     "items",
     "targets"
    ],
    "title": "ConfigStatus"
   },
   "Device": {
    "properties": {
     "device": {
      "type": "string",
      "title": "Device"
     },
     "uuid": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Uuid"
     },
     "label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Label"
     },
     "filesystem": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Filesystem"
     }
    },
    "type": "object",
    "required": [
     "device"
    ],
    "title": "Device"
